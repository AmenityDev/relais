# relais configuration. Every variable is prefixed RELAIS_.
#
# Copy to .env for local development. Never commit a real .env: it holds the key
# material that protects backend passwords and sender credentials.
#
# The two secret variables below are deliberately left EMPTY. relais refuses to
# start without them, and that refusal is the point: shipping a working default
# would mean shipping a key that every reader of this repository already has.
# A loud failure beats a silent deployment with a publicly known key.
#
# Generate your own — `task setup` does it for you, or by hand:
#   relais keygen key      → RELAIS_SECRET_ENCRYPTION_KEYS
#   relais keygen pepper   → RELAIS_SECRET_CREDENTIAL_PEPPER
#
# Only the variables under "required" have no usable default.

# --- required ---------------------------------------------------------------

RELAIS_DB_URL=postgres://relais:relais@127.0.0.1:5432/relais?sslmode=disable

# Seals backend SMTP passwords. Reversible, and rotatable: add a second entry
# ("1:<old>,2:<new>"), point ACTIVE_KEY at it, run `relais backend rewrap`, then
# drop the old entry.
#
#   relais keygen key
RELAIS_SECRET_ENCRYPTION_KEYS=
#RELAIS_SECRET_ENCRYPTION_ACTIVE_KEY=1

# Fingerprints sender credentials. One-way, and NOT rotatable: changing it
# invalidates every existing credential.
#
#   relais keygen pepper
RELAIS_SECRET_CREDENTIAL_PEPPER=

# --- environment and telemetry ----------------------------------------------

RELAIS_ENV=dev
RELAIS_SERVICE_NAME=relais
RELAIS_OBS_LOG_LEVEL=debug
RELAIS_OBS_LOG_FORMAT=text

# OTLP/HTTP base URL of the ClickStack/HyperDX collector. Empty disables export
# and keeps stdout logging only. Application logs never go to Postgres.
#RELAIS_OBS_OTLP_ENDPOINT=http://127.0.0.1:4318
#RELAIS_OBS_OTLP_HEADERS=authorization=Bearer xxxxx
#RELAIS_OBS_TRACES_ENABLED=true
#RELAIS_OBS_TRACES_SAMPLING=1.0

# --- subsystems -------------------------------------------------------------

RELAIS_HTTP_ENABLED=true
RELAIS_HTTP_ADDR=:8080
# Name of the header carrying the real client IP. Leave empty unless a trusted
# proxy sits in front: otherwise a client could forge the IP recorded on a
# rejected submission.
#RELAIS_HTTP_TRUSTED_PROXY_HEADER=X-Forwarded-For

RELAIS_SMTP_ENABLED=true
RELAIS_SMTP_ADDR=:2525
# Implicit-TLS listener (port 465 style). Empty disables it.
#RELAIS_SMTP_TLS_ADDR=:4465
#RELAIS_SMTP_DOMAIN=smtp.example.com

RELAIS_WORKER_ENABLED=true
RELAIS_WORKER_COUNT=5
RELAIS_WORKER_MAX_ATTEMPTS=8

# --- TLS for the submission server ------------------------------------------
#
# Pick exactly one source. Mounted files are how production works; SIGHUP
# reloads them after a renewal, so certbot/Caddy/cert-manager all fit.
#RELAIS_TLS_CERT_FILE=/certs/tls.crt
#RELAIS_TLS_KEY_FILE=/certs/tls.key

# Generated certificate, for tests and local development. Refused when
# RELAIS_ENV is prod unless SELF_SIGNED_ALLOW_IN_PROD is set.
RELAIS_TLS_SELF_SIGNED=true
RELAIS_TLS_SELF_SIGNED_HOSTS=localhost,127.0.0.1
#RELAIS_TLS_SELF_SIGNED_DIR=/var/lib/relais/certs
RELAIS_TLS_MIN_VERSION=1.2

# --- limits and rate limiting -----------------------------------------------

RELAIS_LIMITS_MAX_MESSAGE_BYTES=10485760
RELAIS_LIMITS_MAX_REQUEST_BYTES=15728640
RELAIS_LIMITS_MAX_RECIPIENTS=50

# Per-credential defaults, overridable per credential in the database. Enforced
# per process, not cluster-wide.
RELAIS_RATELIMIT_RPS=10
RELAIS_RATELIMIT_BURST=20

# --- retention --------------------------------------------------------------

# How long the raw message body is kept after delivery, and after a permanent
# failure (longer, so a message can still be replayed).
RELAIS_RETENTION_PAYLOAD_SENT=24h
RELAIS_RETENTION_PAYLOAD_FAILED=168h
RELAIS_RETENTION_IDEMPOTENCY_TTL=24h

# --- admin authentication (OIDC via Authentik) ------------------------------

#RELAIS_OIDC_ISSUER=https://auth.example.com/application/o/relais/
#RELAIS_OIDC_AUDIENCE=relais
#RELAIS_OIDC_GROUPS_CLAIM=groups
#RELAIS_OIDC_ADMIN_GROUP=relais-admin
#RELAIS_OIDC_VIEWER_GROUP=relais-viewer

# --- admin interface (relais-web) -------------------------------------------
# Only needed to run the SvelteKit admin: docker compose --profile web up
#
# RELAIS_WEB_OIDC_BASE_URL is the Authentik ROOT, e.g. https://auth.example.com.
# It is NOT the issuer: arctic appends /application/o/authorize/ to it, so giving
# the issuer produces a doubled path and a 404 that explains nothing. The issuer,
# which does carry /application/o/<slug>/, belongs in RELAIS_OIDC_ISSUER.
RELAIS_WEB_OIDC_BASE_URL=
RELAIS_WEB_OIDC_CLIENT_ID=
RELAIS_WEB_OIDC_CLIENT_SECRET=

# 32 bytes, base64. Encrypts the session cookie. Left empty for the same reason as
# the two above: generate one with `task web:key`.
RELAIS_WEB_SESSION_KEY=

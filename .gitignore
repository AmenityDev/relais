# Secrets, never committed.
.env
.env.local
certs/

# Build output. Every pattern here is anchored with a leading slash: a bare
# "relais" would match at any depth and silently exclude cmd/relais from the
# repository, which is exactly what it did once.
/bin/
/dist/
/relais

# Go test and fuzz artefacts.
*.test
*.out
coverage.*

# Fuzz corpus entries that reproduce a failure are worth committing; the cache
# is not, and Go keeps it outside the repo anyway.

# Frontend (arrives with the SvelteKit admin).
web/node_modules/
web/.svelte-kit/
web/build/

# Editors.
.idea/
.vscode/
*.swp

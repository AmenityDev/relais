  "info": {
    "description": "The sending API, equivalent to the SMTP submission façade: both converge on one pipeline, so a message is authorised the same way whichever it arrived through.\n\nEvery request must be authenticated; there is no anonymous relaying under any condition.\n\nGenerated from the Go types that serve the requests. Do not edit by hand.",
    "title": "relais sending API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/emails": {
      "post": {
        "description": "Accepted means queued, not delivered. Send an Idempotency-Key header to make a retry safe: the same key returns the first result with idempotent_replay set, rather than sending twice.",
        "operationId": "sendEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            },
            "description": "Success."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The body is not valid JSON."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No credential, or one that is not valid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Authenticated, but not allowed to do this."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request was understood and is not acceptable."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limited."
          }
        },
        "summary": "Submit a message for relaying"
      }
    },
    "/v1/emails/{id}": {
      "get": {
        "description": "Scoped to the calling credential: another credential's message is a 404.",
        "operationId": "getEmail",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentMessage"
                }
              }
            },
            "description": "Success."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No credential, or one that is not valid."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Authenticated, but not allowed to do this."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such thing, or not yours."
          }
        },
        "summary": "The status of a message you submitted"
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "servers": [
